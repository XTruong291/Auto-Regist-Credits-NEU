POSTGRES_DB=neu_bot
POSTGRES_USER=neu_bot
POSTGRES_PASSWORD=change_this_password

CLOUDFLARE_TUNNEL_TOKEN=put_cloudflare_tunnel_token_here

# CORS: thay bằng domain Cloudflare thực tế (ví dụ: https://neu.example.com)

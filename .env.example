# Environment Configuration

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Worker Configuration
NUM_WORKERS=4
MAX_CONNECTIONS=200
MAX_KEEPALIVE_CONNECTIONS=100
REQUEST_TIMEOUT_SECONDS=3.0

# Burst Configuration
NUM_BURSTS=4
BURST_DELAY_MS=150
REQUESTS_PER_BURST=120
SEMAPHORE_LIMIT=120

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Registration URL (target)
REGISTRATION_URL=https://tinchi.neu.edu.vn/api/register
LOGIN_URL=https://tinchi.neu.edu.vn/login

# Proxy (optional)
PROXY_LIST=
